
local globe = asset.require("../earth")

local Name = "Tellus - aurora"
local Identifier = "tellus-aurora"
local Description = [[The auroral ovation model is overlaid over a map of the Earth showing day and night and highlighting the cities that might have been able to see it between 9-30-12 and 10-1-12.
The aurora is usually brightest near midnight.
The auroral oval extends into the dayside part of Earth but you cannot see the aurora during the day. As the auroral activity picks up, the auroral oval expands equatorward.
The auroral oval is centered on the geomagnetic pole, not the geographic pole.]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/aurora/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/aurora/4096.webm"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "4096.webm",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
