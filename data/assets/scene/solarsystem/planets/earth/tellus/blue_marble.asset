
local globe = asset.require("../earth")

local Name = "Tellus - blue marble"
local Identifier = "tellus-blue_marble"
local Description = [[Vastness of the Sahara Desert
Shading done in true color: gives Earth's appearance from space]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/blue-marble/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/blue_marble/4096.jpg"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "4096.jpg",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
