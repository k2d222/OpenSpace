
local globe = asset.require("../earth")

local Name = "Tellus - blue marble and nighttime lights"
local Identifier = "tellus-nightlight_anim"
local Description = [[]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/blue-marble-and-nighttime-lights/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/nightlight/anim/4096.webm"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "4096.webm",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
