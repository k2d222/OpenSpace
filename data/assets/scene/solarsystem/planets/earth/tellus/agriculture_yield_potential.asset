
local globe = asset.require("../earth")

local Name = "Tellus - agriculture: cropland yield (potential)"
local Identifier = "tellus-agriculture_yield_potential"
local Description = [[Potential yield for a given area is determined by using the productivity of another region with analogous environmental conditions and optimized water and nutrient input as a benchmark.]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/agriculture-cropland-yield-potential/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/agriculture/yield/potential/4096.png"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "4096.png",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
