
local globe = asset.require("../earth")

local Name = "Tellus - solar system to scale: sun and planets"
local Identifier = "tellus-sun_planet_scales"
local Description = [[]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/solar-system-to-scale-sun-and-planets/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/space/sun/planet_scales/1600.jpg"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "1600.jpg",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
