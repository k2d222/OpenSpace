
local globe = asset.require("../earth")

local Name = "Tellus - hurricane season: 2005"
local Identifier = "tellus-cyclone_2005_season"
local Description = [[]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/hurricane-season-2005/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/cyclone/2005_hurricane_season/2048.webm"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "2048.webm",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
