
local globe = asset.require("../earth")

local Name = "Tellus - carbon dioxide: one year - 2012"
local Identifier = "tellus-carbon_graph"
local Description = [[]]
local Author = "NOAA SoS"
local URL = "https://sos.noaa.gov/catalog/datasets/carbon-dioxide-one-year-2012/"
local License = "https://sos.noaa.gov/copyright/"


local syncdir = asset.resource({
  Name = Name,
  Type = "UrlSynchronization",
  Identifier = Identifier,
  Url = "https://vlc.itn.liu.se/tellus-data/earth/carbon/graph/co2_data_2048.webm"
})


local Layer = {
  Identifier = Identifier,
  Name = Name,
  Enabled = false,
  FilePath = syncdir .. "co2_data_2048.webm",
  Description = Description
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(globe.Earth.Identifier, "Overlays", Layer)
end)

asset.export(Layer)



asset.meta = {
  Name = Name,
  Description = Description,
  Author = Author,
  URL = URL,
  License = License
}
